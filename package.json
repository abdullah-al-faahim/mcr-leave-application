{
  "name": "mcr-leave-application",
  "productName": "Leave Application",
  "version": "1.0.0",
  "description": "Windows desktop wrapper for the Channel i MCR leave application HTML form.",
  "main": "main.js",
  "scripts": {
    "prepare-icon": "node scripts/prepare-icon.js",
    "package-win": "npm run prepare-icon && electron-packager . \"Leave Application\" --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --asar",
    "build-win": "npm run package-win",
    "build-installer": "npm run package-win && makensis -DROOT=\"$(pwd)\" scripts/installer.nsi"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^1.0.0"
  }
}
