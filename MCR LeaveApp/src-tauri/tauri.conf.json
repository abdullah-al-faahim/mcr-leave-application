{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCR Leave Application",
  "version": "1.0.2",
  "identifier": "com.Fahim-Channel-i.mcr-leaveapp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCR Leave Application - Channel i",
        "width": 850,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
